<Project>

  <!-- Runs AFTER each project's own PropertyGroup, so $(IsPackable) reflects the per-project override
       (Directory.Build.props imports first, when IsPackable is still the default false). Packs the shared
       README into the root of every packable NuGet package to satisfy <PackageReadmeFile>, converted for
       nuget.org at pack time (see build/PackageReadme.targets). The LICENSE is declared via
       <PackageLicenseExpression> (SPDX), which needs no packed file. -->
  <Import Project="build/PackageReadme.targets" Condition="'$(IsPackable)' == 'true'" />

  <!-- The package icon is the README logo (128 px, the size nuget.org recommends). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs/logo.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
