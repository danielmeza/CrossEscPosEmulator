<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>ImageSharp implementation of the CrossEscPos rendering abstraction (canvas, image,
      image factory, typeface provider and PNG encoder). A fully managed, WASM-safe render backend —
      no native dependencies — mirroring the SkiaSharp backend so the interpreter produces identical
      output. Fonts are embedded.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrossEscPos.Abstractions\CrossEscPos.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fully managed 2D drawing (glyphs, lines, fills, image compositing). Drawing 3.1.2 already
         depends on SixLabors.ImageSharp 4.1.2 exactly; ImageSharp is still listed explicitly so the
         version this package renders against is visible in one place and in the packed nuspec. -->
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.2" />
    <!-- 4.1.2 is the first release patched against the 2026-10-07 advisory batch (GHSA-jjfr-hcj7-qf5w,
         GHSA-j9gm-c75j-xc9q, GHSA-j3p4-wp97-rph4 high; GHSA-wmxv-xphr-5c9g, GHSA-gwg2-r3hj-4w44
         moderate). No 3.x release is patched, so the warnings-as-errors + NuGetAudit build can only
         stay clean on 4.x. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded monospace font (JetBrains Mono, OFL) loaded from the assembly manifest — no file IO,
         so the package is self-contained and works in the browser sandbox. Explicit LogicalName keeps
         the manifest resource names stable (no path/hyphen munging). -->
    <EmbeddedResource Include="Assets\Fonts\receipt-mono.ttf"            LogicalName="receipt-mono.ttf" />
    <EmbeddedResource Include="Assets\Fonts\receipt-mono-bold.ttf"       LogicalName="receipt-mono-bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\receipt-mono-italic.ttf"     LogicalName="receipt-mono-italic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\receipt-mono-bolditalic.ttf" LogicalName="receipt-mono-bolditalic.ttf" />
  </ItemGroup>

</Project>
